# Database
# Reemplaza con tus credenciales de PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/altiplano?schema=public"

# JWT Secret (opcional, tiene un valor por defecto)
JWT_SECRET="altiplano-secret-key-change-in-production"

# Firebase Admin
FIREBASE_PROJECT_ID="tu-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:3000"

# Server Port
PORT=3001


