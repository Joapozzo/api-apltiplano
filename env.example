# =============================================================================
# Altiplano API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# =============================================================================

# --- Database ---
# PostgreSQL connection string for Prisma (NeonDB, AWS RDS, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/altiplano?schema=public"

# --- Server ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- JWT ---
# Secret key for AES-256-CBC encryption of JWT tokens (min 32 chars recommended)
JWT_SECRET="cambiar-por-un-secreto-seguro-de-al-menos-32-caracteres"

# Session secret for cookie-based auth
JWT_SESSION_SECRET="cambiar-por-otro-secreto-seguro"

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://www.altiplanoexperience.com"

# --- Firebase Admin ---
FIREBASE_PROJECT_ID="tu-project-id"
FIREBASE_PRIVATE_ID="tu-private-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (optional, falls back to local storage) ---
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# --- Resend (optional, emails skip if missing) ---
RESEND_API_KEY="tu-resend-api-key"

# --- Encryption ---
# AES-256-GCM key for encrypting sensitive user data (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If missing or invalid, encryption falls back to plaintext silently.
ENCRYPTION_KEY=""

# --- CSRF ---
# Secret key for CSRF token HMAC signing (min 32 chars recommended)
CSRF_SECRET="cambiar-por-un-secreto-csrf-seguro"

# --- Uploads ---
UPLOAD_MAX_POR_MES=50

