# =============================================================================
# Altiplano API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
#
# REQUIRED vars will cause the server to exit with an error at startup if missing.
# Optional vars are noted with "(optional)" and fall back gracefully.
# =============================================================================

# --- Database (REQUIRED) ---
# PostgreSQL connection string for Prisma (NeonDB, AWS RDS, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/altiplano?schema=public"

# --- Server ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- JWT (REQUIRED - min 32 chars) ---
# Secret for AES-256-CBC encryption of JWT tokens.
# Generate with: node scripts/generate-secrets.mjs
JWT_SECRET="cambiar-por-un-secreto-seguro-de-al-menos-32-caracteres"

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash).
# Defaults to http://localhost:3000 if empty.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://www.altiplanoexperience.com"

# --- Firebase Admin (REQUIRED) ---
FIREBASE_PROJECT_ID="tu-project-id"
FIREBASE_PRIVATE_ID="tu-private-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (optional) ---
# Falls back to local storage if not configured.
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# --- Resend (optional) ---
# Transactional emails are skipped if not configured.
RESEND_API_KEY="tu-resend-api-key"

# --- Encryption Key (REQUIRED - exactly 64 hex chars) ---
# AES-256-GCM key for encrypting sensitive user data (DNI, phone, email, etc.).
# Generate with: node scripts/generate-secrets.mjs
# IMPORTANT: If this is missing or invalid, operations that handle sensitive
# data (inscripciones, usuarios) will FAIL with an error.
ENCRYPTION_KEY="981364327f21f0d5f9af5f0b8c8285e36f3a0028fd338f08a706ef09dc11f4ae"

# --- CSRF Secret (REQUIRED - min 32 chars) ---
# Secret key for CSRF token HMAC signing.
# Generate with: node scripts/generate-secrets.mjs
CSRF_SECRET="cambiar-por-un-secreto-csrf-seguro-de-al-menos-32-caracteres"

# --- Uploads ---
UPLOAD_MAX_POR_MES=50
